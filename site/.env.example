# Integrações opcionais. Sem estas variáveis, os formulários funcionam e os leads aparecem no log do servidor.
# Webhook do CRM (RD Station, HubSpot, Pipedrive ou Zapier/Make) — recebe o JSON do lead.
CRM_WEBHOOK_URL=
# Envio de e-mail transacional via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=comercial@lastro.example
LEAD_PRIORITY_EMAIL=diretoria@lastro.example
RI_NOTIFY_EMAIL=ri@lastro.example
# URL pública do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://lastro.example
